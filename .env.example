# Printer LAN settings (printer screen: Settings > Network)
BAMBU_X2D_IP=192.168.1.92
BAMBU_X2D_ACCESS_KEY=xxxxxxxx
# Optional: pins the printer identity (auto-detected from its TLS certificate if omitted)
BAMBU_X2D_SERIAL=

# Optional: where the overlay is served. 0.0.0.0 = whole local network (http://<mac>.local:8787)
OVERLAY_HOST=0.0.0.0
OVERLAY_PORT=8787

# Optional OBS camera-crop automation. URL + password default to OBS's own
# Tools > WebSocket Server Settings, so usually only the source name matters.
OBS_SOURCE=X2D
# OBS_WS_URL=ws://127.0.0.1:4455
# OBS_WS_PASSWORD=
